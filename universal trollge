TeleportToChests.MouseButton1Up:Connect(function()
    if TeleportToChests.Text == "Teleport To Chests (Off)" then
        TeleportToChests.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        TeleportToChests.Text = "Teleport To Chests (On)"

        _G.Teleport = true
        
        -- Function to position float parts
        local function positionParts()
            local root = game.Players.LocalPlayer.Character.HumanoidRootPart
            FloatParts[1].CFrame = root.CFrame * CFrame.new(0, -3.5, 0)
            FloatParts[2].CFrame = root.CFrame * CFrame.new(-5.5, 2, 0)
            FloatParts[3].CFrame = root.CFrame * CFrame.new(5.5, 2, 0)
            FloatParts[4].CFrame = root.CFrame * CFrame.new(0, 2, 5.5)
            FloatParts[5].CFrame = root.CFrame * CFrame.new(0, 2, -5.5)
            FloatParts[6].CFrame = root.CFrame * CFrame.new(0, 7.5, 0)
        end

        while _G.Teleport do
            local delay = tonumber(TeleportToChestsDelay.Text) or 0.5
            wait(delay)
            
            -- Teleport to regular chests
            for i, v in ipairs(game:GetService("Workspace").chests:GetChildren()) do
                if v:IsA("BasePart") and _G.Teleport then
                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
                    positionParts()
                    wait(delay)
                end
            end
            
            -- Teleport to special chests
            for i, v in ipairs(game:GetService("Workspace"):GetChildren()) do
                if (v.Name == "DarkChest_p" or v.Name == "Weeping Chest-p") and _G.Teleport then
                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
                    positionParts()
                    wait(delay)
                end
            end
        end
    else
        if TeleportToChests.Text == "Teleport To Chests (On)" then
            TeleportToChests.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            TeleportToChests.Text = "Teleport To Chests (Off)"
            _G.Teleport = false
        end
    end
end)

