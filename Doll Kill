-- Get character root part
local function getCharacterRoot(character)
    if not character then return nil end
    
    -- Try different parts in order
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.RootPart then
        return humanoid.RootPart
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp end
    
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if torso then return torso end
    
    return character:FindFirstChild("Head")
end

-- Teleport player to me
local function bringPlayer()
    if not autobringTarget or not autobringActive then return end
    
    local targetChar = autobringTarget.Character
    local myChar = localPlayer.Character
    
    if not targetChar or not myChar then return end
    
    local targetRoot = getCharacterRoot(targetChar)
    local myRoot = getCharacterRoot(myChar)
    
    if not targetRoot or not myRoot then return end
    
    -- Check distance
    local distance = (myRoot.Position - targetRoot.Position).Magnitude
    
    if distance > autobringRange then
        -- Teleport them to me
        targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
    end
end

-- Find player by name
local function findPlayerByName(name)
    for _, player in pairs(Players:GetPlayers()) do
        if player.Name:lower():find(name:lower()) then
            return player
        end
    end
    return nil
end

-- Start autobring
startBtn.MouseButton1Click:Connect(function()
    local playerName = nameBox.Text
    if playerName == "" then
        status.Text = "Type a player name first!"
        return
    end
    
    if autobringActive then
        status.Text = "Already autobringing!"
        return
    end
    
    local player = findPlayerByName(playerName)
    if not player then
        status.Text = "Player not found: " .. playerName
        return
    end
    
    if player == localPlayer then
        status.Text = "Can't autobring yourself!"
        return
    end
    
    autobringTarget = player
    autobringActive = true
    status.Text = "Autobringing: " .. player.Name
    
    -- Create autobring loop
    autobringLoop = RunService.Heartbeat:Connect(function()
        bringPlayer()
    end)
end)

-- Stop autobring
stopBtn.MouseButton1Click:Connect(function()
    autobringActive = false
    
    if autobringLoop then
        autobringLoop:Disconnect()
        autobringLoop = nil
    end
    
    status.Text = "Stopped autobring"
    autobringTarget = nil
end)

-- Toggle GUI visibility
