local toggled = false

local function updateChestCount()
    local folder = workspace:FindFirstChild("chests")
    chestIndicator.Text = folder and ("Chests detected: " .. #folder:GetChildren()) or "Chests detected: 0"
end

-- Connect Kill All button
killAllBtn.MouseButton1Click:Connect(function()
    killAllNPCs()
end)

toggle.MouseButton1Click:Connect(function()
    toggled = not toggled
    toggle.Text = toggled and "Chest Farm: ON" or "Chest Farm: OFF"

    if toggled then
        while toggled do
            updateChestCount()
            local chests = workspace:FindFirstChild("chests")
            if not chests then task.wait(1) continue end

            for _, chest in ipairs(chests:GetChildren()) do
                if not toggled then break end

                lastChestLabel.Text = "Last chest: " .. chest.Name

                local chestPart = chest:IsA("Model") and chest.PrimaryPart or chest:IsA("BasePart") and chest or nil
                if chestPart then
                    if chestPart.Position.Y > HEIGHT_THRESHOLD then
                        lastChestLabel.Text = "Deleted: " .. chest.Name
                        chest:Destroy()
                    else
                        if hrp then
                            hrp.CFrame = chestPart.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.2)

                            local prompt = chest:FindFirstChildOfClass("ProximityPrompt") or chest:FindFirstDescendantWhichIsA("ProximityPrompt")
                            if prompt then
                                fireproximityprompt(prompt, 1)
                                task.wait(0.03)
                            end
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    else
        lastChestLabel.Text = "Last chest: None"
    end
end)

-- Constantly update chest count
task.spawn(function()
    while true do
        updateChestCount()
        task.wait(0.1)
    end
end)
