    toggleFrame.Name = toggleName .. 'Toggle'
    toggleFrame.BackgroundTransparency = 1
    toggleFrame.Position = UDim2.new(0, 0, 0, currentYPosition)
    toggleFrame.Size = UDim2.new(1, 0, 0, 25 * paddingMultiplier)
