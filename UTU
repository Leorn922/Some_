-- Drag logic
local dragging, dragInput, dragStart, startPos

local function updatePosition(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                               startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    toggleVisibilityBtn.Position = UDim2.new(0, frame.Position.X.Offset + frame.Size.X.Offset + 10, 0, frame.Position.Y.Offset + 5)
end

dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

dragBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updatePosition(input)
    end
end)

-- Teleport Logic
local teleportConnection

local function findChestPart(name)
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Name == name then
            return part
        end
    end
    return nil
end

local function startTeleportLoop()
    teleporting = true
    toggleTeleportBtn.Text = "Stop Teleport Loop"
    teleportConnection = RunService.Heartbeat:Connect(function()
        if not teleporting then return end
        local partName = chestNames[teleportIndex]
        local chestPart = findChestPart(partName)
        if chestPart and chestPart:IsA("BasePart") then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = chestPart.CFrame * CFrame.new(0, 3, 0)
                local chestModel = chestPart.Parent
                if chestModel then
                    for _, prompt in ipairs(chestModel:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                            prompt:InputHoldBegin()
                            task.wait(0.3)
                            prompt:InputHoldEnd()
                        end
                    end
                end
            end
        end
        teleportIndex = teleportIndex + 1
        if teleportIndex > #chestNames then
            teleportIndex = 1
        end
        task.wait(10)
    end)
end

local function stopTeleportLoop()
    teleporting = false
    toggleTeleportBtn.Text = "Start Teleport Loop"
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end
end

-- New Kill All function (added here)
local function killAllNPCs()
    sethiddenproperty(player, "SimulationRadius", 112412400000)
    sethiddenproperty(player, "MaxSimulationRadius", 112412400000)
    for _, d in pairs(workspace:GetDescendants()) do
        if d.ClassName == 'Humanoid' and d.Parent.Name ~= player.Name then
            d.Health = 0
        end
    end
end

-- Button click handlers
toggleTeleportBtn.MouseButton1Click:Connect(function()
    if teleporting then
        stopTeleportLoop()
    else
        startTeleportLoop()
    end
end)

killAllBtn.MouseButton1Click:Connect(function()
    killAllNPCs()
end)

