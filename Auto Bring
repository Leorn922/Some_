targetTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        addButton.MouseButton1Click:Connect()
    end
end)

rangePlusButton.MouseButton1Click:Connect(function()
    autobringRange = autobringRange + 5
    if autobringRange > 200 then autobringRange = 5 end
    rangeValueLabel.Text = tostring(autobringRange)
    statusLabel.Text = "Range: " .. autobringRange
end)

rangeMinusButton.MouseButton1Click:Connect(function()
    autobringRange = autobringRange - 5
    if autobringRange < 5 then autobringRange = 200 end
    rangeValueLabel.Text = tostring(autobringRange)
    statusLabel.Text = "Range: " .. autobringRange
end)

startAllButton.MouseButton1Click:Connect(function()
    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer then
            startAutobring(player.Name)
        end
    end
    statusLabel.Text = "Started autobring for all players"
end)

stopAllButton.MouseButton1Click:Connect(function()
    stopAllAutobring()
end)

-- Player tracking
players.PlayerAdded:Connect(function(player)
    task.wait(0.5)
    if isGUIEnabled then
        updatePlayerList()
    end
end)

players.PlayerRemoving:Connect(function(player)
    task.wait(0.5)
    if isGUIEnabled then
        updatePlayerList()
    end
    if autobringTargets[player.Name] then
        stopAutobring(player.Name)
    end
end)

-- Update lists periodically
local updateLoop = runService.Heartbeat:Connect(function()
    if isGUIEnabled then
        updatePlayerList()
        updateActiveList()
    end
end)

-- Auto-start GUI
task.spawn(function()
    task.wait(1)
    isGUIEnabled = true
    mainWindow.Visible = true
    updatePlayerList()
    updateActiveList()
    statusLabel.Text = "Ready - Click players to autobring"
end)

-- Add visual feedback
addButton.MouseEnter:Connect(function()
    addButton.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
end)

addButton.MouseLeave:Connect(function()
    addButton.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
end)

-- Make toggle button draggable too
local toggleDragging = false
local toggleStart = Vector2.new(0, 0)
local togglePosStart = UDim2.new(0, 0, 0, 0)

toggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        toggleDragging = true
        toggleStart = input.Position
        togglePosStart = toggleButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                toggleDragging = false
            end
        end)
    end
end)

userInputService.InputChanged:Connect(function(input)
    if toggleDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - toggleStart
        toggleButton.Position = UDim2.new(
            togglePosStart.X.Scale,
            togglePosStart.X.Offset + delta.X,
            togglePosStart.Y.Scale,
            togglePosStart.Y.Offset + delta.Y
        )
    end
end)

