-- Autobring Functions
local function getCharacterRoot(character)
    if not character then return nil end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.RootPart then
        return humanoid.RootPart
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp end
    
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if torso then return torso end
    
    return character:FindFirstChild("Head")
end

local function teleportPlayer(targetPlayer)
    local myCharacter = localPlayer.Character
    local targetCharacter = targetPlayer.Character
    
    if not myCharacter or not targetCharacter then return false end
    
    local myRoot = getCharacterRoot(myCharacter)
    local targetRoot = getCharacterRoot(targetCharacter)
    
    if not myRoot or not targetRoot then return false end
    
    -- Try to teleport using different methods
    
    -- Method 1: Direct CFrame
    targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
    
    -- Method 2: Break joints and teleport
    targetCharacter:BreakJoints()
    task.wait(0.1)
    targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
    
    return true
end

local function startAutobring(playerName)
    local player = players:FindFirstChild(playerName)
    if not player or player == localPlayer then
        statusLabel.Text = "Invalid player!"
        return
    end
    
    if autobringTargets[playerName] then
        statusLabel.Text = "Already autobringing " .. playerName
        return
    end
    
    autobringTargets[playerName] = player
    statusLabel.Text = "Started autobring: " .. playerName
    
    local loop = runService.Heartbeat:Connect(function()
        if not autobringTargets[playerName] then
            loop:Disconnect()
            return
        end
        
        local targetPlayer = players:FindFirstChild(playerName)
        if not targetPlayer or not targetPlayer.Character then
            autobringTargets[playerName] = nil
            loop:Disconnect()
            updateActiveList()
            statusLabel.Text = playerName .. " left the game"
            return
        end
        
        local myCharacter = localPlayer.Character
        local targetCharacter = targetPlayer.Character
        
        if not myCharacter or not targetCharacter then return end
        
        local myRoot = getCharacterRoot(myCharacter)
        local targetRoot = getCharacterRoot(targetCharacter)
        
        if not myRoot or not targetRoot then return end
        
        local distance = (myRoot.Position - targetRoot.Position).Magnitude
        
        if distance > autobringRange then
            teleportPlayer(targetPlayer)
        end
    end)
    
    autobringLoops[playerName] = loop
    updateActiveList()
end

local function stopAutobring(playerName)
    if autobringTargets[playerName] then
        autobringTargets[playerName] = nil
        
        if autobringLoops[playerName] then
            autobringLoops[playerName]:Disconnect()
            autobringLoops[playerName] = nil
        end
        
        updateActiveList()
        statusLabel.Text = "Stopped: " .. playerName
    end
end

local function stopAllAutobring()
    for playerName, _ in pairs(autobringTargets) do
        stopAutobring(playerName)
    end
    statusLabel.Text = "All autobrings stopped"
end

-- GUI Event Connections
local dragging = false
local dragStart = Vector2.new(0, 0)
local windowStart = UDim2.new(0, 0, 0, 0)

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        windowStart = mainWindow.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

userInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainWindow.Position = UDim2.new(
            windowStart.X.Scale,
            windowStart.X.Offset + delta.X,
            windowStart.Y.Scale,
            windowStart.Y.Offset + delta.Y
        )
    end
end)

